# Production Environment Configuration
# Copy this file to .env before deploying

# Database Configuration
MONGODB_URI=mongodb://admin:GENERATE_MONGO_PASSWORD@mongodb:27017/agent-ai-server?authSource=admin
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=GENERATE_MONGO_PASSWORD

# JWT_SECRET is used ONLY for CSRF token signing, not user authentication
JWT_SECRET=GENERATE_JWT_SECRET

# Qdrant Vector Database Configuration
QDRANT_URL=http://qdrant:6333

# Application Configuration
APP_NAME=Agent AI Server
NODE_ENV=production
LOG_LEVEL=info

# Chatwoot Integration - Set these in production
CHATWOOT_URL=https://your-chatwoot-instance.com
CHATWOOT_API_TOKEN=your-global-chatwoot-api-token
